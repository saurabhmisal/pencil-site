{
  "hosting": {
    "site": "lazo-pencil-site",
    "public": ".firebase-dist",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "python3 scripts/prepare-hosting.py"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/release.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  }
}
